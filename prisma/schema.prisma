generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./service-manager.db"
}

model Service {
  id            String               @id @default(cuid())
  name          String
  description   String?
  command       String
  port          Int?
  noPort        Boolean              @default(false)
  wsl           Boolean              @default(false)
  cudaDevice    String?
  /// Free VRAM (MB) this service needs on each GPU it is pinned to. Null = no admission check.
  minFreeVramMb Int?
  startOnBoot   Boolean              @default(false)

  pid           Int?
  status        String               @default("stopped")
  /// What the service is SUPPOSED to be doing, as opposed to what it is doing.
  /// Set to "running" when it is started or observed listening, and to "stopped" only
  /// by a deliberate stop (the Stop button, a profile switch, a deploy). Auto-restart
  /// reads this, so it can never fight something that was turned off on purpose.
  desiredStatus String               @default("stopped")

  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  profileServices RunProfileService[]
}

/// An immutable record of one configuration change to a service (task-1523).
/// Every create/update/delete/profile-override writes one of these, carrying the
/// reason the change was made plus full before/after snapshots so any past config
/// can be inspected and restored.
model ConfigRevision {
  id            String   @id @default(cuid())
  /// Deliberately NOT a relation: a cascade would erase the record of a service
  /// being deleted, which is exactly the history worth keeping.
  serviceId     String
  /// Denormalised so a revision still reads sensibly after a rename or delete.
  serviceName   String
  profileId     String?
  profileName   String?
  /// create | update | delete | revert | baseline
  changeType    String
  /// ui | agent | api — best-effort attribution taken from the request.
  author        String   @default("ui")
  reason        String
  /// Effective config AFTER the change, JSON. Null for a delete.
  snapshot      String?
  /// Effective config BEFORE the change, JSON. Null for create/baseline.
  previous      String?
  /// [{ field, from, to }] computed at write time so the UI never re-diffs.
  changedFields String   @default("[]")
  /// Set when this revision was produced by reverting an earlier one.
  revertedFromRevisionId String?
  createdAt     DateTime @default(now())

  @@index([serviceId, createdAt])
}

model RunProfile {
  id        String               @id @default(cuid())
  name      String
  isActive  Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  services  RunProfileService[]
}

model RunProfileService {
  id          String     @id @default(cuid())
  profileId   String
  serviceId   String
  cudaDevice  String?
  startOnBoot Boolean    @default(false)
  /// Bring this service back on its own when its port goes dark unexpectedly.
  /// Profile-scoped exactly like startOnBoot: a profile that does not want the service
  /// running must not have it resurrected behind the profile's back.
  autoRestart Boolean    @default(false)
  profile     RunProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  service     Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([profileId, serviceId])
}

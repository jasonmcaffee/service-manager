generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./service-manager.db"
}

model Service {
  id            String   @id @default(cuid())
  name          String
  description   String?
  command       String
  startOnBoot   Boolean  @default(false)
  port          Int?
  cudaDevice    String?

  pid           Int?
  status        String   @default("stopped")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
